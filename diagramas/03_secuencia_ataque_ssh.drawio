<mxfile host="app.diagrams.net">
  <diagram name="Secuencia SSH">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Un ataque SSH contra agent-db se detecta y la IP del atacante se bloquea sola durante 600 s" style="text;html=1;align=left;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1100" height="30" as="geometry" />
        </mxCell>

        <!-- Lifeline headers -->
        <mxCell id="hAtk" value="attacker&#10;.50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hDb" value="agent-db&#10;.40" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="60" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hWaz" value="wazuh-server&#10;.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="llAtk" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1" source="hAtk" target="hAtk">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="190" y="120" as="sourcePoint" />
            <mxPoint x="190" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="llDb" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="120" as="sourcePoint" />
            <mxPoint x="650" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="llWaz" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="120" as="sourcePoint" />
            <mxPoint x="1110" y="900" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="1 - intentos de login SSH (22/TCP)" style="html=1;endArrow=block;html=1;strokeColor=#B85450;strokeWidth=2;fontColor=#B85450;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="190" y="170" as="sourcePoint" />
            <mxPoint x="650" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="2 - sshd anota fallos en auth.log&#10;y el agente Wazuh los lee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="3 - eventos por 1514/TCP" style="html=1;endArrow=block;strokeColor=#3700CC;fontColor=#3700CC;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="290" as="sourcePoint" />
            <mxPoint x="1110" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="s4" value="4 - Decodificador sshd + regla 100001:&#10;mas de 5 fallos en 60 s&#10;= alerta nivel 10 (T1110.001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="320" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="s5" value="5 - Alerta en el dashboard y&#10;aviso por email o Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="410" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Step 6 -->
        <mxCell id="s6" value="6 - Active Response: firewall-drop" style="html=1;endArrow=block;strokeColor=#2E7D32;fontColor=#2E7D32;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="500" as="sourcePoint" />
            <mxPoint x="650" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 7 -->
        <mxCell id="s7" value="7 - iptables bloquea la IP del atacante&#10;durante 600 s (confirmado en vivo:&#10;add 23:35:51, delete 23:45:52)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="530" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Step 8 -->
        <mxCell id="s8" value="8 - conexiones rechazadas" style="html=1;endArrow=block;strokeColor=#2E7D32;fontColor=#2E7D32;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="630" as="sourcePoint" />
            <mxPoint x="190" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 9 -->
        <mxCell id="s9" value="9 - A los 600 s se quita el bloqueo automaticamente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="670" width="300" height="60" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legAtk" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="20" height="20" as="geometry" /></mxCell>
        <mxCell id="legAtkT" value="Ataque" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="778" width="100" height="24" as="geometry" /></mxCell>
        <mxCell id="legDet" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="780" width="20" height="20" as="geometry" /></mxCell>
        <mxCell id="legDetT" value="Deteccion" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="778" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="legResp" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="780" width="20" height="20" as="geometry" /></mxCell>
        <mxCell id="legRespT" value="Respuesta" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="778" width="120" height="24" as="geometry" /></mxCell>

        <mxCell id="footer" value="flujo de una amenaza - ataque SSH contra agent-db, 9 pasos (corregido: el objetivo real del SSH es agent-db, no agent-linux)" style="text;html=1;align=left;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="830" width="900" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
