        <!-- DNS note -->
        <mxCell id="dnsnote" value="Nota sobre DNS&#10;&#10;Si las VM necesitan mantener la resolucion por /etc/hosts (p. ej. wazuh-server),&#10;deberian fijar su DNS a mano: la red ZeroTier podria imponerles uno incorrecto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1060" height="90" as="geometry" />
        </mxCell>

        <!-- Puertos note -->
        <mxCell id="portnote" value="Puertos y protocolo: ZeroTier necesita salida a internet por UDP 9993 (atraviesa NAT sin abrir nada en el router).&#10;Sobre la interfaz zt0 siguen aplicando los mismos puertos de siempre: 1514 y 1515 hacia wazuh-server (agentes), 443 hacia wazuh-server (dashboard),&#10;80 desde attacker hacia agent-linux (web/SQLi), 22 desde attacker hacia agent-db (SSH/fuerza bruta), 5432 desde agent-linux hacia agent-db,&#10;443 saliente desde wazuh-server hacia misp (integracion custom-misp.py)." style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="945" width="1060" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
